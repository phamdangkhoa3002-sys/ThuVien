<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F3F5F9"
    android:id="@+id/main">

    <!-- TIÊU ĐỀ -->

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#5546A5"
        app:title="QUẢN LÝ SÁCH THƯ VIỆN"
        app:titleTextColor="#FFFFFF"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        xmlns:app="http://schemas.android.com/apk/res-auto" />


    <!-- THÔNG TIN SÁCH -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="THÔNG TIN SÁCH"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#5546A5"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/edtMaSach"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:hint="Mã sách"
        android:textSize="14sp"
        android:singleLine="true"
        android:padding="6dp"/>

    <EditText
        android:id="@+id/edtTenSach"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:hint="Tên sách"
        android:textSize="14sp"
        android:singleLine="true"
        android:padding="6dp"/>

    <EditText
        android:id="@+id/edtTacGia"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:hint="Tác giả"
        android:textSize="14sp"
        android:singleLine="true"
        android:padding="6dp"/>

    <EditText
        android:id="@+id/edtTheLoai"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:hint="Thể loại"
        android:textSize="14sp"
        android:singleLine="true"
        android:padding="6dp"/>

    <EditText
        android:id="@+id/edtNamXuatBan"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:hint="Năm xuất bản"
        android:inputType="number"
        android:textSize="14sp"
        android:singleLine="true"
        android:padding="6dp"/>



    <!-- NGÀY THÁNG -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edtNgayNhap"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:hint="Ngày nhập"
            android:textSize="12sp"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:padding="4dp"/>

        <EditText
            android:id="@+id/edtNgayMuon"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:hint="Ngày mượn"
            android:textSize="12sp"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:padding="4dp"/>

        <EditText
            android:id="@+id/edtNgayTra"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:hint="Ngày trả"
            android:textSize="12sp"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:padding="4dp"/>

    </LinearLayout>

    <!-- TRẠNG THÁI -->
    <Spinner
        android:id="@+id/spnTrangThai"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>

    <!-- NÚT CHỨC NĂNG -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnThem"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Thêm"
            android:textSize="12sp"
            android:backgroundTint="#5546A5"/>

    </LinearLayout>

    <!-- DANH SÁCH SÁCH -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:gravity="center_vertical"
        android:text="DANH SÁCH SÁCH"
        android:textColor="#5546A5"
        android:textStyle="bold"
        android:textSize="16sp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDanhSachSach"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"/>

</LinearLayout>
