<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F3F5F9"
    android:id="@+id/main">


    <!-- TIÊU CHÍ TÌM KIẾM -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TÌM KIẾM THEO"
        android:textColor="#5546A5"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="12dp"/>

    <Spinner
        android:id="@+id/spnLoaiTimKiem"
        android:layout_width="match_parent"
        android:layout_height="45dp"/>

    <!-- NHẬP TỪ KHÓA -->
    <EditText
        android:id="@+id/edtTuKhoa"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:hint="Nhập tên sách hoặc tác giả..."
        android:textSize="14sp"
        android:singleLine="true"
        android:padding="8dp"/>

    <!-- DANH SÁCH KẾT QUẢ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:gravity="center_vertical"
        android:text="KẾT QUẢ TÌM KIẾM"
        android:textColor="#5546A5"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvKetQuaTimKiem"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"/>
    <Button
        android:id="@+id/btnQuayLai"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="Quay lại"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#5546A5"/>
</LinearLayout>
