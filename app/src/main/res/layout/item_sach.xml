<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <!-- CHECKBOX BÊN TRÁI -->
        <CheckBox
            android:id="@+id/cbChonSach"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:buttonTint="#5546A5"/>

        <!-- THÔNG TIN SÁCH -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTenSach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên sách"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#5546A5"/>

            <TextView
                android:id="@+id/tvMaSach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mã sách: MS001"
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvTacGia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tác giả: Nguyễn Nhật Ánh"
                android:textSize="13sp"
                android:textColor="#555555"/>

            <TextView
                android:id="@+id/tvTheLoai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thể loại: Văn học"
                android:textSize="13sp"
                android:textColor="#555555"/>

            <TextView
                android:id="@+id/tvNamXuatBan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Năm xuất bản: 2024"
                android:textSize="13sp"
                android:textColor="#555555"/>

            <TextView
                android:id="@+id/tvNgayNhap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ngày nhập: 01/01/2026"
                android:textSize="12sp"
                android:textColor="#777777"/>

            <TextView
                android:id="@+id/tvNgayMuon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ngày mượn: 05/01/2026"
                android:textSize="12sp"
                android:textColor="#777777"/>

            <TextView
                android:id="@+id/tvNgayTra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ngày trả: 10/01/2026"
                android:textSize="12sp"
                android:textColor="#777777"/>

            <!-- TRẠNG THÁI -->
            <TextView
                android:id="@+id/tvTrangThai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang đọc"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#3984C6"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- ICON SỬA VÀ XÓA -->
        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnEditSach"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Sửa sách"
                android:scaleType="fitCenter"
                android:padding="7dp"/>

            <ImageButton
                android:id="@+id/btnDeleteSach"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Xóa sách"
                android:scaleType="fitCenter"
                android:padding="7dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
