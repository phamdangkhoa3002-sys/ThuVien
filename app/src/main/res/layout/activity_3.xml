<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F3F5F9">



    <!-- CHỌN KIỂU LỌC -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LỌC THEO"
        android:textColor="#5546A5"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="12dp"/>

    <Spinner
        android:id="@+id/spnLoaiLoc"
        android:layout_width="match_parent"
        android:layout_height="45dp"/>

    <!-- CHỌN GIÁ TRỊ LỌC -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GIÁ TRỊ LỌC"
        android:textColor="#5546A5"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="8dp"/>

    <Spinner
        android:id="@+id/spnGiaTriLoc"
        android:layout_width="match_parent"
        android:layout_height="45dp"/>

    <!-- DANH SÁCH KẾT QUẢ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:gravity="center_vertical"
        android:text="KẾT QUẢ LỌC"
        android:textColor="#5546A5"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvKetQuaLoc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"/>
    <Button
        android:id="@+id/btnQuayLai"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="Quay lại"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#5546A5"/>
</LinearLayout>
