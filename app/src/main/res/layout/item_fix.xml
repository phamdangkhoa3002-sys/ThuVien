<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F9"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHỈNH SỬA THÔNG TIN SÁCH"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5546A5"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/edtMaSach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mã sách"
            android:inputType="text"
            android:enabled="false"/>

        <EditText
            android:id="@+id/edtTenSach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên sách"
            android:inputType="textCapSentences"/>

        <EditText
            android:id="@+id/edtTacGia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tác giả"
            android:inputType="textCapWords"/>

        <EditText
            android:id="@+id/edtTheLoai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Thể loại"
            android:inputType="textCapWords"/>

        <EditText
            android:id="@+id/edtNamXuatBan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Năm xuất bản"
            android:inputType="number"/>

        <EditText
            android:id="@+id/edtNgayNhap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ngày nhập"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"/>

        <EditText
            android:id="@+id/edtNgayMuon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ngày mượn"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"/>

        <EditText
            android:id="@+id/edtNgayTra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ngày trả"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"/>

        <Spinner
            android:id="@+id/spnTrangThai"
            android:layout_width="match_parent"
            android:layout_height="45dp"/>

        <Button
            android:id="@+id/btnLuuThayDoi"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Lưu thay đổi"
            android:textSize="14sp"
            android:backgroundTint="#5546A5"/>

        <Button
            android:id="@+id/btnThoat"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Thoát"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#777777"/>

    </LinearLayout>

</ScrollView>
